# Backend secrets. Copy to backend/.env. Never commit backend/.env.

# Home Assistant WebSocket API and long-lived token (HA profile > Security > Long-lived tokens)
HA_URL=ws://192.168.1.10:8123/api/websocket
HA_TOKEN=

# First admin, created at start-up only if it does not exist (then you can remove these lines)
BOOTSTRAP_ADMIN=
BOOTSTRAP_PASSWORD=

# Session cookie: true behind HTTPS (Caddy). false only for local development over http.
COOKIE_SECURE=true
