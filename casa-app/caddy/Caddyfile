# Single HTTPS entry point (section 4): "/" frontend, "/api" backend.
{
	admin off
}

(casa) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:8080
	}
}

# Home network: certificate from Caddy's internal CA.
# Install the root certificate on TV, tablet and phones once (see docs/installazione.md).
{$CASA_DOMAIN} {
	tls internal
	import casa
}

# Remote access through Tailscale: Caddy gets the *.ts.net certificate from tailscaled.
# Set TS_DOMAIN in .env (e.g. casa-app.tail1234.ts.net). Without it this block serves localhost.
{$TS_DOMAIN} {
	import casa
}
