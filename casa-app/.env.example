# Docker Compose variables. Copy to .env and fill in (ops/setup.sh does it for you).
# .env is never committed.

# Compose profiles: "video" starts Frigate (needs Intel GPU and cameras);
# "sim" starts the simulated Home Assistant instead of the real one.
COMPOSE_PROFILES=video

# Host name of Casa App on the home network (Caddy, HTTPS with internal CA).
CASA_DOMAIN=casa.local

# Database
POSTGRES_PASSWORD=

# MQTT (Mosquitto): one account shared by Frigate, HA and the backend
MQTT_USER=casa
MQTT_PASSWORD=

# Cameras: EZVIZ verification code (label on the camera) — see frigate/config.yml
FRIGATE_RTSP_PASSWORD=

# Video storage (dedicated SSD)
VIDEO_PATH=/mnt/video
